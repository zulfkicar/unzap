        "body": null
      },
      {
        "step_id": "8",
        "method": "POST",
        "url": "https://api.airtable.com/v0/app_example/Contacts",
        "body": "{\"records\":[{\"fields\":{\"Email\":\"member@example.test\",\"Name\":\"Example Member\"}}]}"
      }
    ]
